# Load the dataset
data(faithful)
# Inspect the structure
str(faithful)
# Summary statistics of the dataset
summary(faithful)
# Prior parameters
mu0 <- 3        # Prior mean
sigma0_sq <- 1  # Prior variance
# Sample statistics
x_bar <- mean(faithful$eruptions)
s_sq <- var(faithful$eruptions)
n <- length(faithful$eruptions)
# Posterior mean
posterior_mean <- (sigma0_sq * x_bar + (s_sq / n) * mu0) / (sigma0_sq + (s_sq / n))
# Posterior variance
posterior_variance <- (s_sq * sigma0_sq) / (sigma0_sq + (s_sq / n))
posterior_mean
posterior_variance
