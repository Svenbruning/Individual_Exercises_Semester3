# Load the dataset
data(iris)
# Inspect the structure of the dataset
str(iris)
# Summary of Sepal.Length by species
aggregate(Sepal.Length ~ Species, data = iris, summary)
# Subset data for setosa and versicolor
setosa <- subset(iris, Species == "setosa")$Sepal.Length
versicolor <- subset(iris, Species == "versicolor")$Sepal.Length
# Sample statistics
mean_setosa <- mean(setosa)
mean_versicolor <- mean(versicolor)
var_setosa <- var(setosa)
var_versicolor <- var(versicolor)
n_setosa <- length(setosa)
n_versicolor <- length(versicolor)
# Manual t-statistic calculation
t_stat_manual <- (mean_setosa - mean_versicolor) / sqrt((var_setosa / n_setosa) + (var_versicolor / n_versicolor))
# Degrees of freedom (Welch's approximation)
df_manual <- ((var_setosa / n_setosa + var_versicolor / n_versicolor)^2) /
(((var_setosa / n_setosa)^2 / (n_setosa - 1)) + ((var_versicolor / n_versicolor)^2 / (n_versicolor - 1)))
# Two-tailed p-value
p_value_manual <- 2 * pt(abs(t_stat_manual), df = df_manual, lower.tail = FALSE)
t_stat_manual
p_value_manual
# Perform a two-sample t-test
t_test_result <- t.test(setosa, versicolor, var.equal = FALSE)
# Display the test result
t_test_result
# Load the dataset
data(sleep)
# Inspect the structure
str(sleep)
# Summary statistics of 'extra' grouped by 'group'
aggregate(extra ~ group, data = sleep, summary)
# Split data into two groups
drug1 <- subset(sleep, group == 1)$extra
drug2 <- subset(sleep, group == 2)$extra
# Calculate differences
differences <- drug2 - drug1
# Sample statistics
mean_diff <- mean(differences)
sd_diff <- sd(differences)
n <- length(differences)
# Calculate the t-statistic
t_stat_manual <- mean_diff / (sd_diff / sqrt(n))
# Degrees of freedom
df <- n - 1
# Two-tailed p-value
p_value_manual <- 2 * pt(-abs(t_stat_manual), df)
t_stat_manual
p_value_manual
# Perform a paired t-test
t_test_result <- t.test(drug2, drug1, paired = TRUE)
# Display the result
t_test_result
# Load the dataset
data(PlantGrowth)
# Inspect the structure of the dataset
str(PlantGrowth)
# Calculate the count and proportion of plants in each group
table(PlantGrowth$group)  # Count
prop.table(table(PlantGrowth$group))  # Proportion
# Count of plants in the ctrl group
ctrl_count <- sum(PlantGrowth$group == "ctrl")
# Total number of plants
total_count <- nrow(PlantGrowth)
# Sample proportion
p_hat <- ctrl_count / total_count
# 95% Confidence Interval calculation
z_value <- 1.96  # For 95% confidence
se <- sqrt((p_hat * (1 - p_hat)) / total_count)  # Standard error
# Confidence interval
ci_lower <- p_hat - z_value * se
ci_upper <- p_hat + z_value * se
p_hat
c(ci_lower, ci_upper)
# Proportion test for the ctrl group
prop_test_result <- prop.test(ctrl_count, total_count, correct = FALSE)
# Display the result
prop_test_result
# Load the dataset
data(InsectSprays)
# Inspect the structure of the dataset
str(InsectSprays)
# Summary statistics of 'count' grouped by 'spray'
aggregate(count ~ spray, data = InsectSprays, summary)
# Overall mean
grand_mean <- mean(InsectSprays$count)
# Group means
group_means <- tapply(InsectSprays$count, InsectSprays$spray, mean)
# Number of observations per group
group_sizes <- table(InsectSprays$spray)
# Between-group Sum of Squares (SSB)
SSB <- sum(group_sizes * (group_means - grand_mean)^2)
# Within-group Sum of Squares (SSW)
SSW <- sum(tapply(InsectSprays$count, InsectSprays$spray, function(x) sum((x - mean(x))^2)))
# Total Sum of Squares (SST)
SST <- SSB + SSW
# Degrees of freedom
df_between <- length(group_means) - 1  # k - 1
df_within <- nrow(InsectSprays) - length(group_means)  # N - k
# Mean Squares
MSB <- SSB / df_between
MSW <- SSW / df_within
# F-statistic
F_stat_manual <- MSB / MSW
F_stat_manual
# Perform ANOVA
anova_result <- aov(count ~ spray, data = InsectSprays)
# Display the ANOVA table
summary(anova_result)
# Load the dataset
data(HairEyeColor)
# Inspect the structure of the dataset
str(HairEyeColor)
# Calculate marginal totals
hair_color_totals <- margin.table(HairEyeColor, 1)  # Marginal totals for hair color
eye_color_totals <- margin.table(HairEyeColor, 2)   # Marginal totals for eye color
# Print the marginal totals
hair_color_totals
eye_color_totals
# Get the observed frequencies (contingency table)
observed <- HairEyeColor
# Calculate the grand total
grand_total <- sum(observed)
# Calculate expected frequencies
expected <- outer(hair_color_totals, eye_color_totals) / grand_total
# Calculate the chi-squared statistic manually
chi_squared_manual <- sum((observed - expected)^2 / expected)
# Load the HairEyeColor dataset
data(HairEyeColor)
# Inspect the structure of the dataset
str(HairEyeColor)
# View the dataset
HairEyeColor
# Calculate marginal totals for hair color and eye color
hair_color_totals <- margin.table(HairEyeColor, 1)  # Marginal totals for hair color
eye_color_totals <- margin.table(HairEyeColor, 2)   # Marginal totals for eye color
# Print the marginal totals
hair_color_totals
eye_color_totals
# Load the HairEyeColor dataset
data(HairEyeColor)
# Inspect the structure of the dataset
str(HairEyeColor)
# Calculate marginal totals for hair color and eye color
hair_color_totals <- margin.table(HairEyeColor, 1)  # Marginal totals for hair color
eye_color_totals <- margin.table(HairEyeColor, 2)   # Marginal totals for eye color
# Print the marginal totals
hair_color_totals
eye_color_totals
# Calculate the total number of observations
total <- sum(HairEyeColor)
# Calculate expected frequencies
expected_frequencies <- outer(hair_color_totals, eye_color_totals) / total
# Print the expected frequencies
expected_frequencies
# Calculate the chi-square statistic manually
observed_frequencies <- as.vector(HairEyeColor)
expected_frequencies_flat <- as.vector(expected_frequencies)
# Chi-square statistic
chi_square_statistic <- sum((observed_frequencies - expected_frequencies_flat)^2 / expected_frequencies_flat)
# Print the chi-square statistic
chi_square_statistic
# Perform chi-square test using chisq.test
chi_square_test <- chisq.test(HairEyeColor)
