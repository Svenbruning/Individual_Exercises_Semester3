# 1. Selectie van kernvariabelen
matches <- subset(matches_raw,
select = c(match_api_id, season, date,
home_team_api_id, away_team_api_id,
home_team_goal, away_team_goal))
# Opshonen van missende waarden
impute_median <- function(x) {
if (is.numeric(x)) {
x[is.na(x)] <- median(x, na.rm = TRUE)
}
return(x)
}
player_attr <- as.data.frame(lapply(player_attr, impute_median))
team_attr <- as.data.frame(lapply(team_attr, impute_medain))
team_attr <- as.data.frame(lapply(team_attr, impute_median))
player_attr <- player_attr[!is.na(player_attr$player_api_id), ]
team_attr   <- team_attr[!is.na(team_attr$team_api_id), ]
# Conversie van datatypes
matches$date <- as.Date(matches$date)
player_attr$preferred_foot <- as.factor(player_attr$preferred_foot)
player_attr$attacking_work_rate <- as.factor(player_attr$attacking_work_rate)
player_attr$defensive_work_rate <- as.factor(player_attr$defensive_work_rate)
# Feature Engineering
matches$match_result <- ifelse(matches$home_team_goal > matches$away_team_goal, "Home Win",
ifelse(matches$home_team_goal < matches$away_team_goal, "Away Win", "Draw"))
matches$goal_difference <- matches$home_team_goal - matches$away_team_goal
player_avg <- aggregate(overall_rating ~ player_api_id, data = player_attr, FUN = mean)
team_avg   <- aggregate(defencePressure ~ team_api_id, data = team_attr, FUN = mean)
# Opslaan van schone dataset
save(matches, player_attr, team_attr, player_avg, team_avg,
countries_raw, leagues_raw, teams_raw, players_raw,
file = "Data/clean_data.RData")
